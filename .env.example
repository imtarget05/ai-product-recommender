# RecSys-AI Environment Configuration

# Application
APP_NAME=RecSys-AI
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# Database
# Default to SQLite for zero-setup local execution
DATABASE_URL=sqlite:///./data/recsys.db
# Example for PostgreSQL + pgvector:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recsys_db

# Redis Cache (Optional - fallback to memory cache when Redis is unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=300

# Recommendation Model Parameters
TOP_K_DEFAULT=10
CF_LATENT_FACTORS=32
CF_REGULARIZATION=0.05
CF_ITERATIONS=15
HYBRID_CF_WEIGHT=0.6
HYBRID_CB_WEIGHT=0.4
COLD_START_THRESHOLD=3
