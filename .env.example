# ==========================================
# RecSys-AI Environment Configuration
# DEPLOYMENT CHỐT: Cloud-Native Traditional ML (Non-LLM core, SLA p95 <50ms)
# Core Retrieve (SVD/Vector) -> Rank (multi-objective) chạy 100% không cần LLM;
# LLM (Ollama/Groq §5-6) chỉ là tiện ích phụ, tắt vẫn recommend bình thường.
# ==========================================

# Application
APP_NAME=RecSys-AI
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------
# 1. Relational Database (Railway Postgres / Local SQLite)
# ------------------------------------------
# Local SQLite fallback:
DATABASE_URL=sqlite:///./data/recsys.db
# Railway Postgres connection string (automatically provided by Railway):
# DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# ------------------------------------------
# 2. Redis Cache (Railway Redis / Local)
# ------------------------------------------
# Railway Redis connection string (automatically provided by Railway):
# REDIS_URL=redis://default:password@redis.railway.internal:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=300

# ------------------------------------------
# 3. Vector Database (Qdrant Cloud Free Tier)
# ------------------------------------------
# Get your free 1GB cluster URL & API key at https://cloud.qdrant.io
# If left empty, system automatically falls back to in-memory Qdrant!
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=product_embeddings
VECTOR_DIMENSION=64

# ------------------------------------------
# 4. Recommendation Model Hyperparameters
# ------------------------------------------
TOP_K_DEFAULT=10
CF_LATENT_FACTORS=32
CF_REGULARIZATION=0.05
CF_ITERATIONS=15
HYBRID_CF_WEIGHT=0.6
HYBRID_CB_WEIGHT=0.4
COLD_START_THRESHOLD=3

# ------------------------------------------
# 5. LLM Agent (Groq Cloud, optional)
# ------------------------------------------
# Leave empty to run fully offline (heuristic fallback replies).
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=4.0

# ------------------------------------------
# 6. Local Ollama (M1 Pro 16GB plan 2026-09-18, optional)
# ------------------------------------------
# When set (e.g. http://localhost:11434) the shopping agent tries local
# qwen2.5:3b first (num_ctx 4096, keep_alive 5m), then Groq, then heuristic.
# Unset = Groq-only behaviour (unchanged). Run Ollama with
# OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1 (16GB RAM).
# Pull: ollama pull qwen2.5:3b
OLLAMA_URL=
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=60.0
# Optional Vietnamese embedding upgrade: qwen3-embedding:0.6b (~400MB).
# TF-IDF 64-dim stays the DEFAULT so Qdrant vectors never break —
# switching embed models requires changing VECTOR_DIMENSION + re-index.
# Pull: ollama pull qwen3-embedding:0.6b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Giới hạn RAM M1 Pro 16GB: 1 request song song, 1 model trong RAM, unload sau 5m idle.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m

# ==========================================
# WP4 Stateless Free-Infra ($0 free-tier)
# ==========================================
# Storage backend: local | s3mock | r2 (R2-compat S3 endpoint)
STORAGE_BACKEND=local
R2_ENDPOINT=

# ==========================================
# Serving safety / readiness (plan 2026-09-18)
# ==========================================
# Deployment environment: development | production. Production fails closed
# when the immutable model bundle is missing/incompatible at startup.
APP_ENV=development
# Immutable model bundle written by scripts/evaluate_models.py.
MODEL_BUNDLE_PATH=data/model_bundle
MODEL_VERSION=recsys-hybrid-v001
# Train-on-start is a development-only convenience; never enable in production.
RECSYS_TRAIN_ON_START=
# Cache mode: auto (memory fallback allowed) | redis (required in production).
CACHE_MODE=auto
# Admin/mutation auth (required before public exposure). Empty = disabled locally.
ADMIN_API_KEY=
# Comma-separated CORS allowlist; wildcard+credentials is never allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# R2 / S3-compatible endpoint (Cloudflare R2 free-tier 10GB)
R2_ENDPOINT=
# DATABASE_URL: default sqlite local; prod trỏ Neon/Supabase free postgres
