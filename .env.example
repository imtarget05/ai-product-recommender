# ==========================================
# RecSys-AI Environment Configuration
# ==========================================

# Application
APP_NAME=RecSys-AI
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------
# 1. Relational Database (Railway Postgres / Local SQLite)
# ------------------------------------------
# Local SQLite fallback:
DATABASE_URL=sqlite:///./data/recsys.db
# Railway Postgres connection string (automatically provided by Railway):
# DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# ------------------------------------------
# 2. Redis Cache (Railway Redis / Local)
# ------------------------------------------
# Railway Redis connection string (automatically provided by Railway):
# REDIS_URL=redis://default:password@redis.railway.internal:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=300

# ------------------------------------------
# 3. Vector Database (Qdrant Cloud Free Tier)
# ------------------------------------------
# Get your free 1GB cluster URL & API key at https://cloud.qdrant.io
# If left empty, system automatically falls back to in-memory Qdrant!
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=product_embeddings
VECTOR_DIMENSION=64

# ------------------------------------------
# 4. Recommendation Model Hyperparameters
# ------------------------------------------
TOP_K_DEFAULT=10
CF_LATENT_FACTORS=32
CF_REGULARIZATION=0.05
CF_ITERATIONS=15
HYBRID_CF_WEIGHT=0.6
HYBRID_CB_WEIGHT=0.4
COLD_START_THRESHOLD=3
